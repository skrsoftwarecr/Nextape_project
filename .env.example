# =============================================================================
# NEXTAPE — Variables de entorno (plantilla)
# Copia este archivo a `.env` (o `.env.local`) y rellena los valores.
# `.env*` está en .gitignore: NUNCA commitees el archivo real.
# =============================================================================

# --- Firebase Web config (PÚBLICO; se expone al cliente con NEXT_PUBLIC_) ---
# Si se dejan vacías, la app usa los valores por defecto en src/lib/firebase/client.ts.
# ⚠️ Definir el proyecto canónico (ver docs/TECH_DEBT.md B3: hoy client.ts usa
#    `studio-4462619429-470d8` y `.firebaserc` usa `nextape-prod`).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google AI / Gemini (SECRETO; SOLO servidor, sin prefijo NEXT_PUBLIC) ---
# Requerido por los flows de Genkit en src/ai/*. En producción (Firebase App Hosting)
# configúralo como secreto, no como variable en texto plano. Ver docs/SECURITY.md.
GEMINI_API_KEY=

# --- Firebase Admin SDK (SECRETO; SOLO servidor — route handlers /api/*) ---
# Necesario para el scoring server-trust (escribir el DNA sin que el cliente pueda falsificarlo).
# En Firebase App Hosting / Google Cloud NO hace falta: se usa Application Default Credentials (ADC).
# En local, define UNA de estas dos:
#   - FIREBASE_SERVICE_ACCOUNT: el JSON del service account en una sola línea, o
#   - GOOGLE_APPLICATION_CREDENTIALS: ruta absoluta al archivo JSON del service account.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
